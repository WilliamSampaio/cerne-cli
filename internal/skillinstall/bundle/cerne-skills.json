{
  "schemaVersion": 1,
  "name": "cerne-skills",
  "version": "0.2.0",
  "description": "Official Cerne skills for AI agents.",
  "skills": [
    {
      "id": "cerne-context",
      "source": "skills/cerne-context",
      "entrypoint": "SKILL.md",
      "adapters": {
        "codex": {
          "installTarget": "~/.codex/skills/cerne-context",
          "invoke": "$cerne-context"
        },
        "claude": {
          "installTarget": "~/.claude/skills/cerne-context",
          "invoke": "/cerne-context"
        }
      },
      "requires": {
        "cerneCliCommand": "cerne context --json",
        "contextSchema": "cerne.context.v1"
      }
    },
    {
      "id": "cerne-git-workflow",
      "source": "skills/cerne-git-workflow",
      "entrypoint": "SKILL.md",
      "adapters": {
        "codex": {
          "installTarget": "~/.codex/skills/cerne-git-workflow",
          "invoke": "$cerne-git-workflow"
        },
        "claude": {
          "installTarget": "~/.claude/skills/cerne-git-workflow",
          "invoke": "/cerne-git-workflow"
        },
        "gemini": {
          "installTarget": "~/.gemini/skills/cerne-git-workflow"
        }
      },
      "requires": {
        "cerneCliCommand": "cerne git inspect --agent <agent> --task <task-id> --json",
        "contextSchema": "cerne.context.v1"
      }
    }
  ]
}
